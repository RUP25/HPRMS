{
  "name": "hprms",
  "version": "1.0.0",
  "description": "Hotel Poinisuk Restaurant Management System - QR ordering for Klong (bar) & Dopwai (restaurant) with IDS billing integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:customer": "npm run build --prefix client",
    "init-db": "node db/init.js",
    "qr": "node scripts/generate-qr.js",
    "seed": "node scripts/seed-menu.js"
  },
  "keywords": ["restaurant", "qr-ordering", "kds", "hotel", "ids-billing", "poinisuk"],
  "author": "Hotel Poinisuk",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "better-sqlite3": "^11.3.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.0"
  }
}
