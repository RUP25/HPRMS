# ---------------------------------------------------------------------------
# HPRMS — copy to `.env` and adjust (never commit real `.env`)
# ---------------------------------------------------------------------------

# development | production
NODE_ENV=development

PORT=3000
HOST=0.0.0.0

# Canonical browser URL for QR codes / emails (no trailing slash). Used with CORS in production.
# On Render you can omit this: the app falls back to RENDER_EXTERNAL_URL when set.
PUBLIC_BASE_URL=http://localhost:3000

# Optional extra origins (comma-separated, no trailing slashes). Used when NODE_ENV=production.
# Example: https://hotel.example.com,https://www.hotel.example.com
CORS_ORIGINS=

# Behind nginx / TLS terminator so req.ip and rate limits see real clients — use true or 1
TRUST_PROXY=0

# SQLite path (default: db/hprms.sqlite next to the project if omitted)
# DB_PATH=./db/hprms.sqlite

# Signing key for operator & steward session tokens.
# With NODE_ENV=production the server refuses to start unless AUTH_SECRET is at least 24 characters.
AUTH_SECRET=change-me-use-at-least-24-characters-in-production

# Login brute-force guard (/auth/login, /stewards/login)
RATE_LIMIT_LOGIN_MAX=40
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# Hotel
HOTEL_NAME=Hotel Poinisuk
RESTAURANT_NAME=Dopwai
BAR_NAME=Klong

# Tax (per India hospitality norms - adjust as needed)
GST_PERCENT=5
SERVICE_CHARGE_PERCENT=0

# Operator PINs (REST /api + Socket.IO). Stewards use PINs stored in DB (seeded in db/init.js).
ADMIN_PIN=2468
KITCHEN_PIN=1111
BAR_PIN=2222
BILLING_PIN=4680

# IDS billing software integration (IDS NEXT FX / SmartHotel etc.)
IDS_ENABLED=false
IDS_BASE_URL=https://your-ids-server.example.com/api
IDS_API_KEY=replace-with-token
IDS_HOTEL_CODE=POINISUK
IDS_OUTLET_KLONG=KLONG
IDS_OUTLET_DOPWAI=DOPWAI
IDS_USERNAME=hprms-bot
IDS_PASSWORD=replace-me
